{
  "name": "dsh-adb",
  "version": "0.1.0",
  "private": true,
  "description": "Semantic Android device control over adb for the DeepSeek Harness (node-addressed UI, selector actions, app/state/screenshot/shell tools)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "adb",
    "android",
    "ui-automation"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
