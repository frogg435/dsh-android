# Build output
build/
app/build/
.gradle/
local.properties

# Signing — never commit
release.keystore
.keystore.env

# Bulk assets. Rebuild them with BUILD.md's "Assembling the assets":
#   usr/      ~120 MB Termux prefix (only the tooling below is tracked)
#   runtime/  ~400 MB node + .so closure + dsh-termux
app/src/main/assets/runtime/
app/src/main/assets/usr/*
# ...except the apt/dpkg tooling, which is ours and small.
!app/src/main/assets/usr/var/
!app/src/main/assets/usr/bin/
!app/src/main/assets/usr/etc/
app/src/main/assets/usr/var/*
!app/src/main/assets/usr/var/lib/
app/src/main/assets/usr/var/lib/*
!app/src/main/assets/usr/var/lib/dsh-apt/
app/src/main/assets/usr/bin/*
!app/src/main/assets/usr/bin/dsh-pkg
!app/src/main/assets/usr/bin/apt-get-dsh
app/src/main/assets/usr/etc/*
!app/src/main/assets/usr/etc/apt/
app/src/main/assets/usr/etc/apt/*
!app/src/main/assets/usr/etc/apt/apt.conf
